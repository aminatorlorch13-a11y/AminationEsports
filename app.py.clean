from flask import Flask, render_template, request, redirect, url_for
from datetime import datetime
import random

from config import Config

from models import (
    db,
    Player,
    Match,
    Tournament,
    AdminAction,
    FounderMessage
)


app = Flask(__name__)

app.config.from_object(Config)

db.init_app(app)


# ============================================================
# PUBLIC PAGES
# ============================================================

@app.route("/")
def home():
    return render_template("index.html")


@app.route("/tournament")
def tournament():

    matches = Match.query.filter(
        Match.status != "cancelled"
    ).order_by(
        Match.scheduled_time.asc(),
        Match.id.asc()
    ).all()

    players = {
        player.id: player
        for player in Player.query.all()
    }

    tournament_obj = Tournament.query.order_by(
        Tournament.id.desc()
    ).first()

    return render_template(
        "tournament.html",
        matches=matches,
        players=players,
        tournament=tournament_obj
    )


@app.route("/live")
def live():
    return render_template("live.html")


@app.route("/standings")
def standings():
    return render_template("standings.html")


@app.route("/players")
def players():
    players_list = Player.query.filter_by(
        active=True
    ).order_by(
        Player.name.asc()
    ).all()

    return render_template(
        "players.html",
        players=players_list
    )


# ============================================================
# PLAYER PROFILE
# ============================================================

@app.route("/player/<int:player_id>")
def player_profile(player_id):

    player = Player.query.get_or_404(player_id)

    player_match = Match.query.filter(
        db.or_(
            Match.player1_id == player.id,
            Match.player2_id == player.id
        ),
        Match.status != "cancelled"
    ).order_by(
        Match.scheduled_time.asc(),
        Match.id.asc()
    ).first()

    players = {
        p.id: p
        for p in Player.query.all()
    }

    return render_template(
        "player_profile.html",
        player=player,
        player_match=player_match,
        players=players
    )


@app.route("/matches")
def matches():
    matches_list = Match.query.filter(
        Match.status != "cancelled"
    ).order_by(
        Match.scheduled_time.asc(),
        Match.id.asc()
