# ============================================================
# CREATE OFFICIAL TOURNAMENT DRAW
# ============================================================

@app.route(
    "/admin/draw-tournament",
    methods=["POST"]
)
def draw_tournament():

    # ----------------------------------------
    # FIND ACTIVE REGISTRATION TOURNAMENT
    # ----------------------------------------

    tournament_obj = Tournament.query.filter_by(
        status="registration"
    ).order_by(
        Tournament.id.desc()
    ).first()

    if not tournament_obj:

        return (
            "No active tournament is available "
            "for the draw."
        ), 400

    # ----------------------------------------
    # APPROVED + ACTIVE PLAYERS ONLY
    # ----------------------------------------

    approved_players = Player.query.filter_by(
        application_status="approved",
        active=True
    ).all()

    # ----------------------------------------
    # MINIMUM PLAYERS
    # ----------------------------------------

    if len(approved_players) < 2:

        return (
            "There are not enough approved players "
            "to create the tournament draw."
        ), 400

    # ----------------------------------------
    # TOURNAMENT CAPACITY
    # ----------------------------------------

    if len(approved_players) > tournament_obj.max_players:

        return (
            "There are more approved players than "
            "the tournament capacity."
        ), 400

    # ----------------------------------------
    # EVEN NUMBER REQUIRED
    # ----------------------------------------

    if len(approved_players) % 2 != 0:

        return (
            "The number of approved players must "
            "be even before the draw can be created."
        ), 400

    # ----------------------------------------
    # PREVENT DUPLICATE DRAW
    # ----------------------------------------

    existing_match = Match.query.filter_by(
        tournament_id=tournament_obj.id
    ).first()

    if existing_match:

        return (
            "The official draw has already been "
            "created for this tournament."
        ), 409

    # ----------------------------------------
    # RANDOMIZE APPROVED PLAYERS
    # ----------------------------------------

    random.shuffle(
        approved_players
    )

    # ----------------------------------------
    # CREATE ROUND 1 MATCHES
    # ----------------------------------------

    created_matches = []

    for i in range(
        0,
        len(approved_players),
        2
    ):

        player1 = approved_players[i]

        player2 = approved_players[i + 1]

        match = Match(

            tournament_id=tournament_obj.id,

            player1_id=player1.id,

            player2_id=player2.id,

            player1_score=0,

            player2_score=0,

            status="scheduled",

            round_name="Round 1",

            scheduled_time=None,

            started_at=None,

            finished_at=None,

            winner_id=None,

            is_live=False

        )

        db.session.add(
            match
        )

        created_matches.append(
            match
        )

    # ----------------------------------------
    # RELEASE THE DRAW
    # ----------------------------------------

    tournament_obj.status = "draw_released"

    # ----------------------------------------
    # SAVE MATCHES
    # ----------------------------------------

    db.session.commit()

    # ----------------------------------------
    # RECORD FOUNDER ACTION
    # ----------------------------------------

    action = AdminAction(

        action="tournament_draw_created",

        notes=(
            f"Created "
            f"{len(created_matches)} "
            f"Round 1 matches for "
            f"{tournament_obj.name}."
        ),

        created_at=datetime.utcnow()

    )

    db.session.add(
        action
    )

    db.session.commit()

    # ----------------------------------------
    # RETURN TO FOUNDER DASHBOARD
    # ----------------------------------------

    return redirect(
        url_for("admin_dashboard")
    )


# ============================================================
# DATABASE INITIALIZATION
# ============================================================

with app.app_context():

    db.create_all()


# ============================================================
# START SERVER
# ============================================================

if __name__ == "__main__":

    app.run(

        debug=True,

        host="0.0.0.0",

        port=5000

    )
