# ============================================================
# PLAYER REGISTRATION
# ============================================================

@app.route("/register", methods=["GET", "POST"])
def register():

    if request.method == "POST":

        name = request.form.get(
            "name",
            ""
        ).strip()

        fc_username = request.form.get(
            "fc_username",
            ""
        ).strip()

        country = request.form.get(
            "country",
            ""
        ).strip()

        squad_ovr = request.form.get(
            "squad_ovr",
            ""
        ).strip()

        terms_accepted = request.form.get(
            "terms_accepted"
        )

        # ----------------------------------------
        # REQUIRED FIELDS
        # ----------------------------------------

        if not name or not fc_username or not country:

            return (
                "Please complete all required fields."
            ), 400

        # ----------------------------------------
        # SQUAD OVR
        # ----------------------------------------

        if not squad_ovr.isdigit():

            return (
                "Squad OVR must be a number."
            ), 400

        squad_ovr = int(squad_ovr)

        if squad_ovr < 1 or squad_ovr > 200:

            return (
                "Invalid Squad OVR."
            ), 400

        # ----------------------------------------
        # TERMS
        # ----------------------------------------

        if terms_accepted != "yes":

            return (
                "You must accept the tournament rules."
            ), 400

        # ----------------------------------------
        # DUPLICATE FC USERNAME
        # ----------------------------------------

        existing_player = Player.query.filter_by(
            fc_username=fc_username
        ).first()

        if existing_player:

            return (
                "This FC Mobile username is already registered."
            ), 409

        # ----------------------------------------
        # CREATE PLAYER
        # ----------------------------------------

        player = Player(

            name=name,

            fc_username=fc_username,

            country=country,

            squad_ovr=squad_ovr,

            application_status="pending",

            terms_accepted=True,

            terms_version="1.0",

            terms_accepted_at=datetime.utcnow(),

            active=True

        )

        db.session.add(player)

        db.session.commit()

        return redirect(
            url_for(
                "registration_success",
                player_id=player.id
            )
        )

    return render_template(
        "register.html"
    )


