# ============================================================
# FOUNDER — CREATE OFFICIAL DRAW
# ============================================================

@app.route(
    "/admin/draw-tournament",
    methods=["POST"]
)
def draw_tournament():

    tournament = Tournament.query.filter_by(
        status="registration"
    ).order_by(
        Tournament.id.desc()
    ).first()

    if not tournament:

        return (
            "No tournament is currently waiting for "
            "the official draw."
        ), 400

    approved_players = Player.query.filter_by(
        application_status="approved",
        active=True
    ).order_by(
        Player.id.asc()
    ).all()

    player_count = len(
        approved_players
    )

    if player_count < 2:

        return (
            "There are not enough approved players "
            "to create the tournament draw."
        ), 400

    if player_count > tournament.max_players:

        return (
            "There are more approved players than "
            "the tournament capacity."
        ), 400

    if player_count & (
        player_count - 1
    ):

        return (
            "The number of approved players must be "
            "2, 4, 8 or 16 so the bracket can advance "
            "cleanly."
        ), 400

    existing_match = Match.query.filter_by(
        tournament_id=tournament.id
    ).first()

    if existing_match:

        return (
            "The official draw already exists. "
            "Use Reset Draw before creating a new one."
        ), 409

    random.shuffle(
        approved_players
    )

    rounds = tournament_rounds(
        player_count
    )

    first_round = rounds[0]

    created_matches = []

    for i in range(
        0,
        player_count,
        2
    ):

        player1 = approved_players[i]
        player2 = approved_players[i + 1]

        match = Match(
            tournament_id=tournament.id,
            player1_id=player1.id,
            player2_id=player2.id,
            player1_score=0,
            player2_score=0,
            status="scheduled",
            round_name=first_round,
            is_live=False
        )

        db.session.add(
            match
        )

        created_matches.append(
            match
        )

    tournament.status = "draw_released"

    action = AdminAction(
        action="tournament_draw_created",
        notes=(
            f"Created official draw for "
            f"{tournament.name} with "
            f"{player_count} approved players."
        ),
        created_at=datetime.utcnow()
    )

    db.session.add(
        action
    )

    db.session.commit()

    return redirect(
        url_for(
            "admin_dashboard"
        )
    )


# ============================================================
# FOUNDER — RESET / CANCEL DRAW
# ============================================================

@app.route(
    "/admin/reset-tournament",
    methods=["POST"]
)
def reset_tournament():

    tournament = Tournament.query.order_by(
        Tournament.id.desc()
    ).first()

    if not tournament:

        return (
            "No tournament exists to reset."
        ), 400

    matches = Match.query.filter_by(
        tournament_id=tournament.id
    ).all()

    deleted_count = len(
        matches
    )

    for match in matches:

        db.session.delete(
            match
        )

    # If a previous test already produced a champion
    # or runner-up, return those players to approved.
    Player.query.filter(
        Player.application_status.in_([
            "champion",
            "runner_up"
        ])
    ).update(
        {
            "application_status": "approved",
            "active": True
        },
        synchronize_session=False
    )

    tournament.status = "registration"

    action = AdminAction(
        action="tournament_draw_reset",
        notes=(
            f"Reset official tournament draw. "
            f"Removed {deleted_count} generated matches."
        ),
        created_at=datetime.utcnow()
    )

    db.session.add(
        action
    )

    db.session.commit()

    return redirect(
        url_for(
            "admin_dashboard"
        )
    )


# ============================================================
# FOUNDER — RECORD MATCH RESULT
# ============================================================

@app.route(
    "/admin/match/<int:match_id>/result",
    methods=["POST"]
)
def record_match_result(match_id):

    match = Match.query.get_or_404(
        match_id
    )

    tournament = Tournament.query.get_or_404(
        match.tournament_id
    )

    if match.status == "finished":

        return (
            "This match has already been completed."
        ), 409

    winner_id = request.form.get(
        "winner_id",
        ""
    ).strip()

    if not winner_id.isdigit():

        return (
            "Please select the winning player."
        ), 400

    winner_id = int(
        winner_id
    )

    if winner_id not in [
        match.player1_id,
        match.player2_id
    ]:

        return (
            "The selected winner is not part of this match."
        ), 400

    player1_score = request.form.get(
        "player1_score",
        "0"
    ).strip()

    player2_score = request.form.get(
        "player2_score",
        "0"
    ).strip()

    if not player1_score.isdigit():
        player1_score = "0"

    if not player2_score.isdigit():
        player2_score = "0"

    match.player1_score = int(
        player1_score
    )

    match.player2_score = int(
        player2_score
    )

    match.winner_id = winner_id

    match.status = "finished"

    match.is_live = False

    match.finished_at = datetime.utcnow()

    tournament.status = "in_progress"

    # --------------------------------------------------------
    # FINAL
    # --------------------------------------------------------

    if match.round_name == "Final":

        loser_id = (
            match.player2_id
            if winner_id == match.player1_id
            else match.player1_id
        )

        winner = Player.query.get(
            winner_id
        )

        loser = Player.query.get(
            loser_id
        )

        winner.application_status = "champion"
        loser.application_status = "runner_up"

        tournament.status = "completed"

        action = AdminAction(
            player_id=winner_id,
            action="tournament_completed",
            notes=(
                f"{winner.name} won the final of "
                f"{tournament.name} and became champion."
            ),
            created_at=datetime.utcnow()
        )

        db.session.add(
            action
        )

        db.session.commit()

        return redirect(
            url_for(
                "admin_dashboard"
            )
        )

    # --------------------------------------------------------
    # AUTOMATIC ADVANCEMENT
    # --------------------------------------------------------

    next_match = create_next_round_match(
        tournament,
        match
    )

    action = AdminAction(
        player_id=winner_id,
        action="match_result_recorded",
        notes=(
            f"Winner recorded for Match #{match.id}. "
            f"Winner ID: {winner_id}."
        ),
        created_at=datetime.utcnow()
    )

    db.session.add(
        action
    )

    if next_match:

        action2 = AdminAction(
            action="automatic_advancement",
            notes=(
                f"Created {next_match.round_name} "
                f"match #{next_match.id} "
                f"automatically from completed matches."
            ),
            created_at=datetime.utcnow()
        )

        db.session.add(
            action2
        )

    db.session.commit()

    return redirect(
        url_for(
            "admin_dashboard"
        )
    )


