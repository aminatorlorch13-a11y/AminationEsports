@app.route(
    "/admin/founder/public-announcement",
    methods=["POST"]
)
def founder_public_announcement():

    tournament = Tournament.query.order_by(
        Tournament.id.desc()
    ).first()

    if not tournament:
        return (
            "No tournament exists."
        ), 404

    title = request.form.get(
        "title",
        ""
    ).strip()

    message = request.form.get(
        "message",
        ""
    ).strip()

    if not title:
        return (
            "Announcement title is required."
        ), 400

    if not message:
        return (
            "Announcement message is required."
        ), 400

    if len(title) > 150:
        return (
            "Announcement title is too long."
        ), 400

    if len(message) > 5000:
        return (
            "Announcement message is too long."
        ), 400

    action = AdminAction(
        action="public_notice",
        notes=(
            f"{title}\n\n"
            f"{message}"
        ),
        created_at=datetime.utcnow()
    )

    db.session.add(action)
    db.session.commit()

    return redirect(
        url_for("admin_dashboard")
    )



