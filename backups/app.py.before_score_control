@app.route(
    "/admin/founder/player/<int:player_id>/status",
    methods=["POST"]
)
def founder_player_status(player_id):

    player = Player.query.get_or_404(player_id)

    new_status = request.form.get(
        "status",
        ""
    ).strip()

    allowed_statuses = [
        "pending",
        "approved",
        "waitlist",
        "withdrawn",
        "removed",
        "suspended",
        "eliminated",
        "champion",
        "runner_up"
    ]

    if new_status not in allowed_statuses:
        return "Invalid player status.", 400

    old_status = player.application_status

    player.application_status = new_status

    if new_status in [
        "removed",
        "suspended",
        "withdrawn"
    ]:
        player.active = False

    elif new_status in [
        "pending",
        "approved",
        "waitlist"
    ]:
        player.active = True

    action = AdminAction(
        player_id=player.id,
        action="founder_player_status_changed",
        old_status=old_status,
        new_status=new_status,
        notes=(
            f"Founder changed {player.name} "
            f"from {old_status} to {new_status}."
        ),
        created_at=datetime.utcnow()
    )

    db.session.add(action)
    db.session.commit()

    return redirect(
        url_for("admin_dashboard")
    )


