# ============================================================

@app.route(
    "/admin/founder/match/<int:match_id>/live",
    methods=["POST"]
)
def founder_live_match_control(match_id):

    match = Match.query.get_or_404(match_id)

    action_type = request.form.get(
        "action",
        ""
    ).strip()

    if action_type not in [
        "start",
        "stop",
        "finish"
    ]:
        return "Invalid live match action.", 400

    old_status = match.status
    old_live = bool(match.is_live)

    if action_type == "start":

        if match.status == "finished":
            return (
                "A finished match cannot be started again."
            ), 409

        # Only one match should be live at a time.
        other_live_matches = Match.query.filter(
            Match.is_live.is_(True),
            Match.id != match.id
        ).all()

        for other_match in other_live_matches:
            other_match.is_live = False

        match.is_live = True
        match.status = "live"

        if not match.started_at:
            match.started_at = datetime.utcnow()

    elif action_type == "stop":

        match.is_live = False

        if match.status == "live":
            match.status = "scheduled"

    elif action_type == "finish":
        if match.status == "finished":
            return "This match is already finished.", 409

        if match.player1_score is None or match.player2_score is None:
            return (
                "Both player scores are required before finishing."
            ), 400

        if match.player1_score < 0 or match.player2_score < 0:
            return "Scores cannot be negative.", 400

        if match.player1_score == match.player2_score:
            return (
                "A finished match must have a winning score."
            ), 400

        if match.player1_score > match.player2_score:
            match.winner_id = match.player1_id
            loser_id = match.player2_id
        else:
            match.winner_id = match.player2_id
            loser_id = match.player1_id

        match.is_live = False
        match.status = "finished"
        match.finished_at = datetime.utcnow()

        # Update player statistics.
        from models import PlayerStatistic

        for player_id in [
            match.player1_id,
            match.player2_id
        ]:
            stats = PlayerStatistic.query.filter_by(
                player_id=player_id
            ).first()

            if not stats:
                stats = PlayerStatistic(
                    player_id=player_id,
                    matches_played=0,
                    wins=0,
                    draws=0,
                    losses=0,
                    goals=0,
                    assists=0,
                    clean_sheets=0,
                    saves=0,
                    critical_saves=0
                )
                db.session.add(stats)

            stats.matches_played = (
                stats.matches_played or 0
            ) + 1

            if player_id == match.winner_id:
                stats.wins = (stats.wins or 0) + 1
            elif player_id == loser_id:
                stats.losses = (stats.losses or 0) + 1

            if player_id == match.player1_id:
                stats.goals = (
                    stats.goals or 0
                ) + (match.player1_score or 0)
            else:
                stats.goals = (
                    stats.goals or 0
                ) + (match.player2_score or 0)

        # Advance the winner when another feeder match
        # in this round has also been completed.
        tournament = Tournament.query.get(
            match.tournament_id
        )

        if tournament:
            next_match = create_next_round_match(
                tournament,
                match
            )

            # If this was the Final, there is no next match.
            # The tournament can therefore be completed.
            if (
                match.round_name == "Final"
                and next_match is None
            ):
                tournament.status = "completed"

        action_labels = {
        "start": "started live match",
        "stop": "stopped live match",
        "finish": "finished match"
    }

    action = AdminAction(
        action="founder_live_match_control",
        notes=(
            f"Founder {action_labels[action_type]}. "
            f"Match ID: {match.id}. "
            f"Previous status: {old_status}. "
            f"New status: {match.status}. "
            f"Previous live state: {old_live}. "
            f"New live state: {bool(match.is_live)}."
        ),
        created_at=datetime.utcnow()
    )

    db.session.add(action)
    db.session.commit()

    return redirect(
        url_for("admin_dashboard")
    )



