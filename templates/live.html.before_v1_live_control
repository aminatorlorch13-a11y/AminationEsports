<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Live — Amination Esports</title>

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #050505;
            color: white;
            font-family: Arial, sans-serif;
        }

        header {
            padding: 28px 20px;
            text-align: center;
            border-bottom: 1px solid #222;
        }

        .brand {
            font-size: 30px;
            font-weight: bold;
        }

        .brand span {
            color: #e2b936;
        }

        nav {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 22px;
            padding: 22px 15px;
            border-bottom: 1px solid #222;
        }

        nav a {
            color: white;
            text-decoration: none;
        }

        nav a:hover {
            color: #e2b936;
        }

        .container {
            max-width: 900px;
            margin: auto;
            padding: 45px 20px;
        }

        h1 {
            color: #e2b936;
        }

        .live-card {
            background: #111;
            border: 1px solid #292929;
            border-radius: 16px;
            padding: 28px;
            margin-top: 20px;
        }

        .live-label {
            color: #ff4040;
            font-weight: bold;
            font-size: 18px;
        }

        .players {
            display: grid;
            grid-template-columns:
                1fr 80px 1fr;
            align-items: center;
            gap: 15px;
            margin-top: 25px;
        }

        .player {
            padding: 20px;
            background: #080808;
            border-radius: 12px;
            text-align: center;
        }

        .score {
            font-size: 30px;
            font-weight: bold;
            text-align: center;
        }

        .empty {
            margin-top: 30px;
            padding: 35px;
            background: #111;
            border: 1px solid #292929;
            border-radius: 16px;
            text-align: center;
            color: #999;
        }

    </style>

</head>

<body>

<header>

    <div class="brand">
        AMINATION <span>ESPORTS</span>
    </div>

</header>


<nav>

    <a href="{{ url_for('home') }}">Home</a>
    <a href="{{ url_for('tournament') }}">Tournament</a>
    <a href="{{ url_for('live') }}">Live</a>
    <a href="{{ url_for('standings') }}">Standings</a>
    <a href="{{ url_for('players') }}">Players</a>

</nav>


<div class="container">

    <h1>
        🔴 LIVE MATCHES
    </h1>

    <p>
        Follow Amination matches while they are
        being played.
    </p>


    {% if matches %}

        {% for match in matches %}

            <div class="live-card">

                <div class="live-label">
                    🔴 LIVE NOW
                </div>

                <div>
                    {{ match.round_name or "Tournament Match" }}
                </div>


                <div class="players">

                    <div class="player">

                        <strong>
                            {{ players[match.player1_id].name }}
                        </strong>

                    </div>


                    <div class="score">

                        {{ match.player1_score or 0 }}
                        -
                        {{ match.player2_score or 0 }}

                    </div>


                    <div class="player">

                        <strong>
                            {{ players[match.player2_id].name }}
                        </strong>

                    </div>

                </div>

            </div>

        {% endfor %}

    {% else %}

        <div class="empty">

            🔴 No matches are live right now.

            <br><br>

            Check the Tournament and Matches pages
            for the official schedule and results.

        </div>

    {% endif %}

</div>

</body>

</html>
